{
  "name": "vue-3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check-types && vite build",
    "preview": "vite preview",
    "check-types": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@vee-validate/yup": "4.15.1",
    "@vueuse/core": "14.4.0",
    "element-plus": "2.14.6",
    "pinia": "4.0.3",
    "vee-validate": "4.15.1",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.3.0",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.9.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-vue": "10.10.0",
    "prettier": "3.9.6",
    "sass": "1.103.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
